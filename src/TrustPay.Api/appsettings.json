{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },


  "ConnectionStrings": {
    "Redis": "127.0.0.1:6380"
  },
  "JwtSettings": {
    "Issuer": "TrustPay",
    "Audience": "TrustPayUsers",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpiryDays": 7

  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning" }
    }
  }


}
